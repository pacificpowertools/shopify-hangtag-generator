# Shopify Admin API credentials
# Create a Custom App in Shopify Admin → Apps → App development
# Grant read_products scope
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your public storefront URL (used to build QR code links)
STORE_URL=https://pacificpowertools.com

# Server port (default 3000)
PORT=3000
